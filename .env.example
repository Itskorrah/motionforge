# Optional AI providers; API billing is SEPARATE from ChatGPT, Claude, Gemini or Grok subscriptions.
# Never commit actual keys. Use `node --env-file=.env studio.mjs ...` if using this file.
# OPENAI_API_KEY=replace_with_key
# ANTHROPIC_API_KEY=replace_with_key
# GEMINI_API_KEY=replace_with_key
# XAI_API_KEY=replace_with_key
# Optional: Chrome binary override (otherwise auto-detected).
# CHROME_PATH=/path/to/chrome
